{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
      },
      "serif": { "$type": "fontFamily", "$value": ["Georgia", "serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "Menlo", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.25 },
      "md": { "$type": "number", "$value": 1.5 },
      "loose": { "$type": "number", "$value": 1.75 }
    },
    "letterSpacing": {
      "tight": { "$type": "dimension", "$value": "-0.01em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.04em" }
    },
    "transform": {
      "none": { "$type": "textCase", "$value": "none" },
      "uppercase": { "$type": "textCase", "$value": "uppercase" }
    }
  }
}
