{
  "name": "@uds/demo-react",
  "version": "0.0.0",
  "private": true,
  "description": "React 19 demo that installs Universal DS from tarballs.",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@uds/react": "workspace:*",
    "@uds/themes": "workspace:*",
    "@uds/tokens": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.8"
  },
  "nx": {
    "tags": [
      "type:app",
      "framework:react"
    ],
    "targets": {
      "typecheck": {
        "command": "node ../../../tools/demo-verify/verify.mjs typecheck",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "@uds/demo-verify:pack"
        ],
        "cache": false
      },
      "e2e": {
        "command": "node ../../../tools/demo-verify/verify.mjs e2e",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "typecheck"
        ],
        "cache": false
      }
    }
  }
}
