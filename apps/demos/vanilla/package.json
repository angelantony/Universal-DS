{
  "name": "@uds/demo-vanilla",
  "version": "0.0.0",
  "private": true,
  "description": "HTML demo that installs Universal DS from tarballs.",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@uds/components": "workspace:*",
    "@uds/themes": "workspace:*",
    "@uds/tokens": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.8"
  },
  "nx": {
    "tags": [
      "type:app",
      "framework:none"
    ],
    "targets": {
      "typecheck": {
        "command": "node ../../../tools/demo-verify/verify.mjs typecheck",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "@uds/demo-verify:pack"
        ],
        "cache": false
      },
      "e2e": {
        "command": "node ../../../tools/demo-verify/verify.mjs e2e",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "typecheck"
        ],
        "cache": false
      }
    }
  }
}
